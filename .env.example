# Public deployment configuration
NEXT_PUBLIC_SITE_URL=https://your-domain.example
NEXT_PUBLIC_COMPANY_NAME=French Rent Car
NEXT_PUBLIC_COMPANY_LOCATION=Dubai, UAE
NEXT_PUBLIC_COMPANY_ADDRESS=TO_BE_CONFIRMED
NEXT_PUBLIC_COMPANY_LATITUDE=TO_BE_CONFIRMED
NEXT_PUBLIC_COMPANY_LONGITUDE=TO_BE_CONFIRMED
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_COMPANY_PHONE=TO_BE_CONFIRMED
NEXT_PUBLIC_COMPANY_EMAIL=TO_BE_CONFIRMED
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=https://www.google.com/maps?output=embed&q=French+car+rental+Dubai
NEXT_PUBLIC_OPENING_HOURS=TO_BE_CONFIGURED

# Keep all sample fleet data in demo mode. Do not use demo prices for payments.
DEMO_DATA=true

# PostgreSQL. Use a managed production database and a restricted database user.
DATABASE_URL=postgresql://user:password@localhost:5432/french_rent_car

# Stripe (hosted Checkout). Test keys (sk_test_) work directly; a live key (sk_live_)
# is only used when STRIPE_MODE=LIVE. Never commit real keys.
STRIPE_MODE=TEST
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint https://<domain>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
