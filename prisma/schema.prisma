generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  // Direct (non-pooled) connection used by `prisma migrate` (Neon).
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum AdminRole {
  OWNER
  ADMIN
  STAFF
}

model Vehicle {
  id           String        @id @default(cuid())
  slug         String        @unique
  name         String
  category     String
  categories   String[]
  year         Int?
  seats        Int?
  doors        Int?
  transmission String?
  fuel         String?
  imageUrls    String[]
  dailyAED     Int
  weeklyAED    Int?
  monthlyAED   Int?
  sortOrder    Int           @default(0)
  isDemo       Boolean       @default(true)
  isActive     Boolean       @default(false)
  reservations Reservation[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([isActive, isDemo])
}

model Reservation {
  id               String            @id @default(cuid())
  reference        String            @unique
  vehicleId        String
  vehicle          Vehicle           @relation(fields: [vehicleId], references: [id])
  fullName         String
  email            String
  phone            String
  pickupAt         DateTime
  returnAt         DateTime
  message          String?           @db.Text
  estimatedAED     Int
  status           ReservationStatus @default(PENDING)
  isDemo           Boolean           @default(true)
  /// Visitor language (en/fr/ar), used for the payment link.
  locale           String            @default("en")
  /// SHA-256 of the visitor IP (anti-abuse rate limiting only).
  clientIpHash     String?
  payment          Payment?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([vehicleId, pickupAt, returnAt, status])
  @@index([status, createdAt])
  @@index([clientIpHash, createdAt])
  @@index([phone, createdAt])
}

model Payment {
  id                String        @id @default(cuid())
  reservationId     String        @unique
  reservation       Reservation   @relation(fields: [reservationId], references: [id])
  stripeSessionId   String?       @unique
  stripePaymentId   String?       @unique
  amountAED         Int
  currency          String        @default("aed")
  status            PaymentStatus @default(UNPAID)
  isTest            Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         AdminRole @default(STAFF)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
